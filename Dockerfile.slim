# Slim alternative for hosts with a tight image-size limit.
#
# The main `Dockerfile` uses the official Playwright image (contains every
# browser, ~2.4 GB compressed). If the host rejects it because of the image
# size or the build time limit, replace `Dockerfile` with this file: it
# installs only Chromium + the required system libraries (~1.2 GB) and the
# browser build exactly matches playwright==1.49.1 from requirements.txt.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DATA_DIR=/data \
    DATABASE_URL=sqlite+aiosqlite:////data/playerok.db \
    SELECTORS_FILE=/app/selectors.yaml

WORKDIR /app

# The time zone database (Europe/Moscow and friends) must exist in the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install --with-deps chromium \
    && rm -rf /root/.cache/pip

COPY app ./app
COPY selectors.yaml ./selectors.yaml

RUN mkdir -p /app/data /data

CMD ["python", "-m", "app.main"]
