# Copy this file to .env and fill every required value.
# Never commit .env to git.

# --- Telegram ---
# Get a token from @BotFather.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwnToken
# First-run main administrator. The password is used only to create the account;
# the bot forces a password change on the first login.
ADMIN_LOGIN=gladmin
ADMIN_INITIAL_PASSWORD=1234

# --- Storage and encryption ---
DATABASE_URL=sqlite+aiosqlite:///./data/playerok.db
DATA_DIR=data
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-me-with-a-generated-fernet-key

# --- Playerok ---
PLAYEROK_BASE_URL=https://playerok.com
# Optional. If empty, the bot tries to detect the username from the session.
PLAYEROK_USERNAME=
SELECTORS_FILE=selectors.yaml
HEADLESS=true
BROWSER_TIMEOUT_MS=45000
NAVIGATION_TIMEOUT_MS=60000
# Optional custom user agent. Leave empty to use the built-in default.
# USER_AGENT=

# --- Automation ---
# Dry-run is the safe default. Live mode must be enabled by the main admin.
DRY_RUN=true
POLL_INTERVAL_SECONDS=60
ACTION_DELAY_MIN_SECONDS=3
ACTION_DELAY_MAX_SECONDS=12
MAX_SALES_PER_CYCLE=5
MAX_COOKIE_FILE_BYTES=1000000

# --- Misc ---
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
